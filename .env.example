# Autobought CRM. None of these are needed to run it on your own machine:
# anything not set is simulated or switched off, and the app says so at start-up.

PORT=3100
NODE_ENV=production
APP_URL=https://crm.autobought.ca          # used in links inside texts and emails
DATA_DIR=/data                             # Railway volume. Without it every deploy starts empty.

# --- First run only: creates one admin when there are no accounts ---------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- Demo only: fills an EMPTY database with fictional data on first boot ---
SEED_DEMO=
DEMO_PASSWORD=                             # at least 10 characters

# --- Lead intake -----------------------------------------------------------
# A. Meta Instant Form. In the Meta app: Webhooks > Page > subscribe to "leadgen",
#    callback https://<APP_URL>/webhooks/meta, verify token = META_VERIFY_TOKEN.
META_VERIFY_TOKEN=                         # any long random string you choose
META_APP_SECRET=                           # App settings > Basic. Checks Meta's signature.
META_PAGE_TOKEN=                           # Page token with leads_retrieval (System User, never expires)
# B. autobought.ca/dealers (Jotform). Form > Settings > Integrations > Webhooks:
#    https://<APP_URL>/webhooks/jotform?secret=<JOTFORM_WEBHOOK_SECRET>
JOTFORM_WEBHOOK_SECRET=
# Optional tidy-JSON door (Zapier, backfills): POST /webhooks/lead, header x-webhook-secret
WEBHOOK_SECRET=

# --- Speed-to-lead alerts ----------------------------------------------------
# Who gets them is set per person on the Dashboard > Team ("Text me new leads").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                               # your Twilio number, e.g. +15875550000
RESEND_API_KEY=                            # resend.com, with autobought.ca verified
EMAIL_FROM=Autobought CRM <crm@autobought.ca>
NOTIFY_ALLOWLIST=                          # staging only: comma-separated emails / +1 numbers allowed

# --- Ad spend (Meta Marketing API) ---------------------------------------------
META_AD_ACCOUNT_ID=                        # act_1234567890 or just the digits
META_ADS_TOKEN=                            # System User token with ads_read (defaults to META_PAGE_TOKEN)
META_API_VERSION=v23.0
AD_SYNC_HOUR=10                            # daily pull, UTC
AD_SYNC_LOOKBACK_DAYS=7                    # re-pull this many days: Meta revises recent spend

# --- Conversions API (same dataset + token as the dealer portal's CAPI setup) ---
META_DATASET_ID=                           # the Pixel / dataset id
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=                 # set while testing in Events Manager, then remove
CAPI_EVENT_WORKING=Working
CAPI_EVENT_SIGNED=Signed

# --- Lead bank + dealer portal ------------------------------------------------
LEADBANK_URL=https://lead-bank-production.up.railway.app
LEADBANK_EMAIL=                            # a STAFF login in the lead bank, made for the CRM
LEADBANK_PASSWORD=
LEADBANK_WEBHOOK_SECRET=                   # the lead bank's WEBHOOK_SECRET (for shoppers)
CONSUMER_FUNNEL_ID=                        # lead bank funnel that shoppers on dealer forms go into
LEADBANK_CATEGORY_MAP=                     # e.g. rv_marine:rv,trailer  (default rv_marine:rv)
WELCOME_FROM=Autobought <dealers@autobought.ca>
WELCOME_BCC=                               # e.g. rory@emarket.digital

# --- Stripe (payment links for signed dealers) ---------------------------------
# Dashboard > Developers > API keys. Webhook endpoint: https://<APP_URL>/webhooks/stripe
# with events checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false                 # true once Stripe Tax is set up (adds GST/HST)
HANDOFF_AFTER_PAYMENT=true                 # portal login only after they pay (when Stripe is set)

RUN_SCHEDULER=true                         # false on any extra replica
